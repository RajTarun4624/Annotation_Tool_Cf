# Copy to .env next to docker-compose.yml. Every value here has an insecure
# default in the compose file; set them all before serving real users.

# Postgres password (db service + backend connection)
DB_PASS=change-me-strong-db-password

# JWT signing key: long random string (e.g. `openssl rand -hex 48`)
SECRET_KEY=change-me-64-random-hex-characters

# Seed admin account - used ONLY when the account does not exist yet; the
# password is never rewritten on restart, rotate it in the app afterwards.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-once-then-rotate-in-app

# API worker processes. Keep WEB_CONCURRENCY x 20 (pool) < Postgres max_connections (200).
WEB_CONCURRENCY=4
