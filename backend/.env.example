# ---------- Application ----------
APP_NAME=Prompt Attack Annotation Platform API
API_V1_STR=/api/v1
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- PostgreSQL Database ----------
# The app auto-creates DB_NAME on startup (via MAINTENANCE_DB, default "postgres")
# if it does not exist yet.
DB_USER=postgres
DB_PASS=postgres123
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=annotation_tool_promptattack

# ---------- Folders ----------
UPLOAD_FOLDER=uploads
# Plain-HTML frontend served by FastAPI at "/" (relative to the backend dir).
FRONTEND_DIR=../frontend

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:8005,http://127.0.0.1:8005,http://localhost:3000,http://127.0.0.1:3000

# ---------- Admin ----------
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123
